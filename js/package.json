{
  "name": "code-pipeline",
  "version": "0.0.1",
  "description": "Agentic pipeline for prompt-driven codebase updates, with MCP-based configuration of downstream platforms and configurable guardrails.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "ISC",
  "author": "",
  "keywords": [],
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:status": "tsx --env-file-if-exists=.env src/db/migrate.ts status",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215",
    "@cyanheads/git-mcp-server": "2.15.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "mongoose": "^9.8.0",
    "openapi-types": "^12.1.3",
    "pino": "10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "26.1.1",
    "lefthook": "2.1.10",
    "pino-pretty": "13.1.3",
    "tsc-alias": "1.9.1",
    "tsup": "^8.5.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
